{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "allowJs": true
  },
  "include": [
    "tests/**/*.ts",
    "supabase/functions/_shared/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
