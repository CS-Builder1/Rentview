# Disposable local Supabase. Copy this file to .env, then supply your local
# publishable/anon key. Never put a service-role or provider secret in EXPO_PUBLIC_*.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-local-publishable-or-anon-key

# Paid checkout stays gated until trusted provider binding is implemented.
EXPO_PUBLIC_LEMONSQUEEZY_STORE_URL=
EXPO_PUBLIC_PAYPAL_PLAN_URL=

# Local callback/QR origin. Supply your reviewed HTTPS origin for a later release.
EXPO_PUBLIC_APP_URL=http://localhost:8081
